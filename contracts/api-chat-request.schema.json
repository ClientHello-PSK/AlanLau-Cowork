{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chat API Request",
  "description": "Schema for POST /api/chat request body",
  "type": "object",
  "required": ["message"],
  "properties": {
    "message": {
      "type": "string",
      "description": "User message content",
      "minLength": 1,
      "maxLength": 100000
    },
    "chatId": {
      "type": "string",
      "description": "Chat session identifier for resuming conversations",
      "pattern": "^chat_[0-9]+_[a-z0-9]+$"
    },
    "userId": {
      "type": "string",
      "description": "User identifier",
      "default": "default-user"
    },
    "model": {
      "type": "string",
      "description": "DeepSeek model to use",
      "enum": ["deepseek-v4-flash", "deepseek-v4-pro"],
      "default": "deepseek-v4-flash"
    },
    "thinkingMode": {
      "type": "string",
      "description": "Thinking/reasoning mode",
      "enum": ["normal", "extended"],
      "default": "normal"
    },
    "files": {
      "type": "array",
      "description": "File attachments",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "data": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
